# API key do Resend (obtenha em https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxx"

# Seu e-mail de envio verificado (ex: notificacoes@seudominio.com)
# Precisa ser um domínio verificado no seu painel do Resend
EMAIL_FROM="onboarding@resend.dev"

# Para onde as mensagens do formulário de contato devem ser enviadas
CONTACT_EMAIL="team@yourdomain.com"

# URL principal do site
NEXT_PUBLIC_APP_URL="https://seu-dominio.com"

# Payload CMS
DATABASE_URI="postgres://payload:payload@localhost:5433/payload"
PAYLOAD_SECRET="troque-por-um-valor-secreto-aleatorio"